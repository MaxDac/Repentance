<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Repentance</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="src\**" />
    <Compile Remove="tests\**" />
    <Compile Remove="tools\**" />
  </ItemGroup>
  <!-- Godot-free code lives in class libraries; Godot script classes must stay in this assembly. -->
  <ItemGroup>
    <ProjectReference Include="src\Repentance.Rules\Repentance.Rules.csproj" />
    <ProjectReference Include="src\Repentance.Audio\Repentance.Audio.csproj" />
  </ItemGroup>
  <Import Project="addons\GodotInk\GodotInk.props" />
</Project>
