<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Godot 4.7's prebuilt Android template only runs net9.0 (docs/ci-and-release.md#android). -->
    <TargetFramework Condition="'$(GodotTargetPlatform)' == 'android'">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Repentance</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="src\**" />
    <Compile Remove="tests\**" />
    <Compile Remove="tools\**" />
  </ItemGroup>
  <!-- Godot-free code lives in class libraries; Godot script classes must stay in this assembly. -->
  <ItemGroup>
    <ProjectReference Include="src\Repentance.Rules\Repentance.Rules.csproj" />
    <ProjectReference Include="src\Repentance.Audio\Repentance.Audio.csproj" />
  </ItemGroup>
  <Import Project="addons\GodotInk\GodotInk.props" />
</Project>
