<Project Sdk="Microsoft.NET.Sdk">
  <!-- Music tool: regenerates the recorded instrument notes and renders tracks to WAV (see Program.cs) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Repentance.Tools</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\scripts\Core\SoundSynth*.cs" LinkBase="Linked" />
    <Compile Include="..\..\scripts\Core\MusicSynth*.cs" LinkBase="Linked" />
    <Compile Include="..\..\scripts\Core\Recordings.cs" Link="Linked\Recordings.cs" />
  </ItemGroup>
</Project>
