<Project Sdk="Microsoft.NET.Sdk">
  <!-- Godot-free sound and music synthesis, shared by the game, the tests and tools/music. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Godot 4.7's prebuilt Android template only runs net9.0 (docs/ci-and-release.md#android). -->
    <TargetFramework Condition="'$(GodotTargetPlatform)' == 'android'">net9.0</TargetFramework>
    <RootNamespace>Repentance</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Repentance.Audio.Tests" />
  </ItemGroup>
</Project>
