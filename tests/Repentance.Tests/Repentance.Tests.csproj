<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Repentance.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
  </ItemGroup>
  <ItemGroup>
    <!-- Godot-free libraries, so tests don't need the Godot SDK. -->
    <ProjectReference Include="..\..\src\Repentance.Rules\Repentance.Rules.csproj" />
    <ProjectReference Include="..\..\src\Repentance.Audio\Repentance.Audio.csproj" />
  </ItemGroup>
  <!-- The same ink compiler and runtime as the game (downloaded on first build), so StoryIntegrityTests can walk the real story. -->
  <PropertyGroup>
    <GodotProjectDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</GodotProjectDir>
  </PropertyGroup>
  <Import Project="..\..\addons\GodotInk\GodotInk.props" />
</Project>
